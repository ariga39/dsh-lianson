{
  "name": "dsh-liaison",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Let Codex delegate work to a DeepSeek Harness session that the user can also open in dsh Web",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.22.3"
  },
  "bin": {
    "dsh-liaison": "./src/bin.ts"
  },
  "main": "./src/plugin.ts",
  "exports": {
    ".": "./src/plugin.ts",
    "./cli": "./src/cli.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "verify": "corepack pnpm run typecheck && corepack pnpm run lint && corepack pnpm run test:unit",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --config .oxlintrc.json src tests scripts",
    "test:unit": "node --test tests/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs"
  },
  "dependencies": {
    "commander": "15.0.0",
    "ws": "8.21.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:./deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-api-gateway": "link:./deepseek-harness/packages/api/gateway",
    "@deepseek-ai/dsh-api-remotes": "link:./deepseek-harness/packages/api/remotes",
    "@deepseek-ai/dsh-api-session-controller": "link:./deepseek-harness/packages/api/session-controller",
    "@deepseek-ai/dsh-api-workspace-controller": "link:./deepseek-harness/packages/api/workspace-controller",
    "@deepseek-ai/dsh-brand": "link:./deepseek-harness/packages/util/brand",
    "@deepseek-ai/dsh-client-connection": "link:./deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-home-paths": "link:./deepseek-harness/packages/util/home-paths",
    "@deepseek-ai/dsh-host-webserver": "link:./deepseek-harness/packages/host/webserver",
    "@deepseek-ai/dsh-llm": "link:./deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-sandbox": "link:./deepseek-harness/packages/sandbox/sandbox",
    "@deepseek-ai/dsh-sandbox-policy": "link:./deepseek-harness/packages/sandbox/sandbox-policy",
    "@deepseek-ai/dsh-session": "link:./deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-session-title": "link:./deepseek-harness/packages/session/session-title",
    "@deepseek-ai/dsh-typert-protocol": "link:./deepseek-harness/packages/typert/protocol",
    "@deepseek-ai/dsh-typert-registry": "link:./deepseek-harness/packages/typert/registry",
    "@deepseek-ai/dsh-user-approval": "link:./deepseek-harness/packages/interaction/user-approval",
    "@deepseek-ai/dsh-user-questions": "link:./deepseek-harness/packages/interaction/user-questions",
    "@deepseek-ai/node-addon-system": "link:./deepseek-harness/native/system/packages/entry",
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "6.0.3"
  }
}
