{
  "name": "dsh-liaison",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "External operator smoke for the pinned DeepSeek Harness Web profile",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "24.22.3",
    "pnpm": "11.28.5"
  },
  "scripts": {
    "smoke:slice0": "node scripts/bootstrap.ts && corepack pnpm run verify",
    "verify": "corepack pnpm run typecheck && corepack pnpm run lint && corepack pnpm run test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --config .oxlintrc.json src scripts tests",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:./deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-api-gateway": "link:./deepseek-harness/packages/api/gateway",
    "@deepseek-ai/dsh-api-remotes": "link:./deepseek-harness/packages/api/remotes",
    "@deepseek-ai/dsh-api-session-controller": "link:./deepseek-harness/packages/api/session-controller",
    "@deepseek-ai/dsh-api-workspace-controller": "link:./deepseek-harness/packages/api/workspace-controller",
    "@deepseek-ai/dsh-brand": "link:./deepseek-harness/packages/util/brand",
    "@deepseek-ai/dsh-client-connection": "link:./deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-commands": "link:./deepseek-harness/packages/interaction/commands",
    "@deepseek-ai/dsh-llm": "link:./deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-permission-presets": "link:./deepseek-harness/packages/interaction/permission-presets",
    "@deepseek-ai/dsh-session": "link:./deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-typert-protocol": "link:./deepseek-harness/packages/typert/protocol",
    "@deepseek-ai/dsh-typert-registry": "link:./deepseek-harness/packages/typert/registry",
    "@deepseek-ai/dsh-user-questions": "link:./deepseek-harness/packages/interaction/user-questions",
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.61.1",
    "typescript": "6.0.3",
    "ws": "8.21.3"
  }
}
